# ==============================================================================
# Registrale-DOU & Ro-DOU Dashboard — Git Ignore Rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment & Secret variables
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.pfx
*credentials*.json
*service_account*.json
client_secret*.json
CONFIGURACOES_SISTEMA.md
*CONFIGURACOES*.md

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Databases, SQLite & Local Volumes
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
data/*
!data/.gitkeep

# Flask Sessions & Cache
flask_sessions/
flask_session/
instance/
.webassets-cache

# Docker mounts & runtime logs
mnt/
mnt/pgdata/
mnt/airflow-logs/
*.log
logs/
download_inlabs/
tmp/
/tmp/

# Unit test & coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Generated Airflow DAG Partitions (keep base template and examples)
dag_confs/Pesquisa_cnpj_part_*.yaml
dag_confs/Pesquisa_cnpj_sync.yaml

# IDE & OS specifics
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
.DS_Store
Thumbs.db
*.swp
*.swo

# Distribution & Build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# mypy / typing
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
