# ==============================================================================
# Registrale-DOU & Ro-DOU Dashboard — Environment Variables
# ==============================================================================

# Airflow User & Group IDs (no Linux/macOS, use: id -u / id -g)
AIRFLOW_UID=50000
AIRFLOW_GID=50000

# Airflow Admin Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow Core Settings
AIRFLOW__CORE__DEFAULT_TIMEZONE=America/Sao_Paulo
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=true
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=Uqv6pwYWJn7xifR3QAkifMTkupos8mkxaQL2Q7Ydsqw=
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=42

# Database PostgreSQL (Airflow & INLABS)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# Ro-DOU Dashboard Secret Key
SECRET_KEY=registrale-dou-super-secret-key-2026

# Airflow REST API URL
AIRFLOW_URL=http://airflow-webserver:8080

# OpenSearch Configuration
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_USER=OPENSEARCH_USER
OPENSEARCH_PASS=OPENSEARCH_PASS

# Optional AI Providers for Summarization (e.g. openai, gemini, azure-openai)
AI_PROVIDERS=

# SMTP Server for Notifications (smtp4dev default in Docker)
AIRFLOW__SMTP__SMTP_HOST=smtp4dev
AIRFLOW__SMTP__SMTP_PORT=25
AIRFLOW__SMTP__SMTP_MAIL_FROM=notificacoes@registrale.com.br
AIRFLOW__SMTP__SMTP_STARTTLS=false
# AIRFLOW__SMTP__SMTP_USER=
# AIRFLOW__SMTP__SMTP_PASSWORD=
